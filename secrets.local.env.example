# 复制为 secrets.local.env 并填入真实值。secrets.local.env 已被 .gitignore 排除。
# build.sh 会 source 本文件,把槽位替换成真实订阅 URL / 显示名 / secret。
#
#   cp secrets.local.env.example secrets.local.env
#   vim secrets.local.env
#   make

# —— 各槽位订阅 URL(槽位与优先级在 providers.conf 里定)——
export SUB_P1="https://example.com/your-sub-1"
export SUB_P2="https://example.com/your-sub-2"
export SUB_P3="https://example.com/your-sub-3"
export SUB_P4="https://example.com/your-sub-4"

# —— 各槽位节点显示名前缀(可留空,留空则用槽位 KEY 如 P1)——
export NAME_P1="Provider1"
export NAME_P2="Provider2"
export NAME_P3="Provider3"
export NAME_P4="Provider4"

# —— external-controller 面板密钥(网关那份用)——
export CONTROLLER_SECRET="change-me-to-a-strong-random-secret"
